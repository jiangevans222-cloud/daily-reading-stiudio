{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/lesson.schema.json",
  "title": "Daily Reading public lesson",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99999
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "level": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "minutes": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 180
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "minItems": 1,
      "maxItems": 20
    },
    "translation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "minItems": 1,
      "maxItems": 20
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true
          },
          "answer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "explanations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            "minItems": 4,
            "maxItems": 4
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "description": "原文中的连续英文引文，不加段落号或中文说明"
          },
          "skill": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "stem",
          "options",
          "answer",
          "explanations",
          "evidence",
          "skill"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "maxItems": 5
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "minItems": 5,
        "maxItems": 5
      },
      "minItems": 8,
      "maxItems": 30
    },
    "sentences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "structure": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "tip": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "text",
          "structure",
          "meaning",
          "tip"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 10
    },
    "expressions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phrase": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "example": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "phrase",
          "meaning",
          "example"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 20
    },
    "review": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "structure": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "minItems": 1,
          "maxItems": 20
        },
        "logic": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "minItems": 1,
          "maxItems": 30
        },
        "traps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "minItems": 1,
          "maxItems": 30
        },
        "takeaway": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "selfCheck": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "minItems": 1,
          "maxItems": 30
        }
      },
      "required": [
        "summary",
        "structure",
        "logic",
        "traps",
        "takeaway",
        "selfCheck"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "day",
    "date",
    "title",
    "subtitle",
    "topic",
    "level",
    "source",
    "minutes",
    "paragraphs",
    "translation",
    "questions",
    "vocabulary",
    "sentences",
    "expressions",
    "review"
  ],
  "additionalProperties": false
}
